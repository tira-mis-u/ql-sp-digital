<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>DpiUnawareGdiScaled</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8629</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Views\Main\MainForm.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Controls\ProductCardControl.cs">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Views\**\*Control.cs">
      <SubType>UserControl</SubType>
    </Compile>
  </ItemGroup>

</Project>